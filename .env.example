# Copy this file to .env and fill in your values. .env is gitignored.

# Discogs personal access token.
# Get one from: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# User-Agent sent with every request to Discogs (required by their API).
DISCOGS_USER_AGENT=AlbumTracker/0.1 +joe@local

# Only used by scripts/auto_note.py. Leave blank if you are not generating notes.
GEMINI_API_KEY=
